{
  "name": "eternal-jukebox-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "wasm": "wasm-pack build ../crates/eternal-web --target web --out-dir ../../web/src/wasm --release",
    "dev": "vite",
    "build": "pnpm wasm && tsc -b && vite build",
    "build:pages": "pnpm wasm && tsc -b && vite build --base \"$VITE_BASE_PATH\"",
    "check": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "^26.6.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "playwright": "^1.64.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "^5.0.3",
    "vitest-browser-react": "^2.3.0"
  }
}
