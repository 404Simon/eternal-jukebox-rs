{
  "name": "eternal-jukebox-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "wasm": "wasm-pack build ../crates/eternal-web --target web --out-dir ../../web/src/wasm --release",
    "dev": "vite",
    "build": "pnpm wasm && tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@vitejs/plugin-react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript": "~6.0.0",
    "typescript-eslint": "latest",
    "vite": "latest"
  }
}
